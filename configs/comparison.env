# environemtn
CONDA_BASE=/opt/software/pc2/EB-SW/software/Miniforge3/25.3.0-3
CONDA_ENV=cola_llama_factory
MODULE_INIT='module purge && module load toolchain/foss/2024a system/CUDA/12.6.0 lib/NCCL/2.22.3-GCCcore-13.3.0-CUDA-12.6.0'

# model / data
MODEL_NAME_OR_PATH=meta-llama/Llama-3.2-1B
GENERIC_TOKENIZED_PATH=/scratch/hpc-prf-merlin/project_data/moe_study/tokenized/common_sft
GENERIC_DATASET_NAME=c4
MOELPR_TOKENIZED_PATH=/scratch/hpc-prf-merlin/project_data/moe_study/tokenized/hierarchical_adapter/llama-3.1-8B_tokenizer/5_langs
MOELPR_LANGUAGE_COLUMN=language
MOELPR_LANGUAGE_MAP=/scratch/hpc-prf-merlin/project_data/moe_study/tokenized/hierarchical_adapter/moelpr_5_langs_lang_map.json
MOELPR_ORIGINAL_LANGUAGE=eng_Latn

# Output location for all runs
OUTPUT_ROOT=/scratch/hpc-prf-merlin/project_data/moe_study/comparison_runs
DATASET_DIR=./LLaMA-Factory/data

# logging / scheduling
WANDB_PROJECT=moe-study-comparison
WANDB_ENTITY=my_wandb_team
WANDB_RUN_GROUP=refactor-benchmark
SBATCH_ARGS=""
