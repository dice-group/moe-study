{
  "local_mini_quick": {
    "extends": "local_mini",
    "output_root": "outputs/pipeline_runs/local_mini_quick",
    "sample": {
      "output_dir": "outputs/pipeline_runs/local_mini_quick/sampled"
    },
    "tokenization": {
      "output_dir": "outputs/pipeline_runs/local_mini_quick/tokenized"
    },
    "training": {
      "output_dir": "outputs/pipeline_runs/local_mini_quick/runs",
      "runs": [
        {"id": "lora_baseline", "kind": "lora"},
        {
          "id": "mixlora_4exp_k2",
          "kind": "mixlora",
          "params": {
            "num_experts": 4,
            "top_k": 2,
            "router_init_range": 0.02,
            "jitter_noise": 0.0,
            "router_loss": true,
            "router_aux_loss_coef": 0.001,
            "moe_target_modules": "gate_proj,down_proj,up_proj"
          }
        },
        {
          "id": "adamole_4exp",
          "kind": "adamole",
          "params": {
            "num_experts": 4,
            "aux_loss_coef": 0.001,
            "max_threshold": 0.25
          }
        },
        {
          "id": "hmora_8exp_k2",
          "kind": "hmora",
          "params": {
            "num_experts": 8,
            "dropout": 0.1,
            "top_k_routing_strategy": true,
            "top_k": 2,
            "use_task_router": true,
            "task_router_only": false,
            "share_router_for_qkv": true,
            "share_router_for_w_i": true,
            "num_router_mlp_layers": 1,
            "router_hidden_dim": 32,
            "epsilon_alpha": 4.0,
            "alpha_shift": -2.0,
            "alpha_low_bound": 0.2,
            "alpha_up_bound": 0.8,
            "use_load_balancing_loss": false,
            "use_div_loss": true,
            "gamma_div_certain_t": 0.4,
            "gamma_div_balance_t": 1.0,
            "gamma_div_certain_s": 0.4,
            "gamma_div_balance_s": 1.0,
            "lambda_auxiliary": 0.003,
            "lambda_lm": 1.0,
            "use_hydra_lora": false,
            "eta_b": 1.0,
            "task_token": "?",
            "num_encoder_layer": 1
          }
        }
      ]
    },
    "summary": {
      "gate_json": "outputs/pipeline_runs/local_mini_quick/gate.json",
      "summary_csv": "outputs/pipeline_runs/local_mini_quick/summary.csv"
    }
  }
}
