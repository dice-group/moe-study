{
  "sigterm_jit_smoke_otus_cluster": {
    "extends": "moe_study_profile_otus_cluster_10_langs",
    "output_root": "outputs/pipeline_runs/sigterm_jit_smoke_otus_cluster",
    "tokenization": {
      "enabled": false,
      "output_dir": "outputs/pipeline_runs/moe_study_profile_otus_cluster_10_langs/tokenized"
    },
    "audit": {
      "enabled": false
    },
    "benchmark": {
      "enabled": false
    },
    "baseline_eval": {
      "enabled": false
    },
    "summary": {
      "enabled": false
    },
    "report": {
      "enabled": false
    },
    "wandb": {
      "enabled": false
    },
    "stage_executors": {
      "train": {
        "extra_sbatch_flags": [
          "--signal=B:USR1@300"
        ]
      }
    },
    "training": {
      "output_dir": "outputs/pipeline_runs/sigterm_jit_smoke_otus_cluster/runs",
      "report_to": "none",
      "extra_env": {
        "FORCE_TORCHRUN": "0"
      },
      "executor": {
        "time": "00:06:00"
      },
      "train": {
        "max_steps": 1000000,
        "save_steps": 999999,
        "save_total_limit": 1,
        "logging_steps": 10
      },
      "runs": [
        {
          "id": "lora_sigterm",
          "kind": "lora",
          "lora": {
            "alpha": 8,
            "rank": 4
          },
          "train": {
            "batch_size": 8,
            "grad_accum": 2
          }
        }
      ]
    }
  },
  "sigterm_jit_eval_chain_otus_cluster": {
    "extends": "sigterm_jit_smoke_otus_cluster",
    "output_root": "outputs/pipeline_runs/sigterm_jit_eval_chain_otus_cluster",
    "benchmark": {
      "enabled": true,
      "tasks_file": "configs/lm_eval_tasks_sigterm_smoke.txt",
      "include_belebele": true,
      "include_sib200": false,
      "include_taxi1500": false,
      "include_flores": false,
      "batch_size": "1",
      "allow_missing_lm_eval": false,
      "wandb_mode": "disabled",
      "output_dir": "outputs/pipeline_runs/sigterm_jit_eval_chain_otus_cluster/benchmarks"
    },
    "final_eval_loss": {
      "enabled": true,
      "batch_size": 1,
      "output_subdir": "final_eval_loss"
    },
    "training": {
      "output_dir": "outputs/pipeline_runs/sigterm_jit_eval_chain_otus_cluster/runs"
    }
  }
}
